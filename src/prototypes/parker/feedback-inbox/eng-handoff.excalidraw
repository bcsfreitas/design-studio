    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 20,
      "frameId": "muotyuwbxj6vi",
      "height": 50,
      "id": "mv8r5pn8s0cime",
      "lineHeight": 1.25,
      "originalText": "1 Land on the Overview. The key numbers are at the top: open issues, new, high priority, resolved.",
      "seed": 142307170,
      "text": "1 Land on the Overview. The key numbers are at\nthe top: open issues, new, high priority, resolved.",
      "textAlign": "left",
      "type": "text",
      "version": 1,
      "versionNonce": 1575680680,
      "verticalAlign": "top",
      "width": 458,
      "x": 110,
      "y": 582
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 20,
      "frameId": "muotyuwbxj6vi",
      "height": 75,
      "id": "mv8r5pn87hhjfi",
      "lineHeight": 1.25,
      "originalText": "2 Click a number. The feedback inbox opens already filtered, with a bar that says what's showing, and Clear.",
      "seed": 1015142395,
      "text": "2 Click a number. The feedback inbox opens\nalready filtered, with a bar that says what's\nshowing, and Clear.",
      "textAlign": "left",
      "type": "text",
      "version": 1,
      "versionNonce": 1541608082,
      "verticalAlign": "top",
      "width": 458,
      "x": 808,
      "y": 582
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 20,
      "frameId": "muotyuwbxj6vi",
      "height": 50,
      "id": "mv8r5pn9a02mx2",
      "lineHeight": 1.25,
      "originalText": "3 Click a row to open it. Status and priority save as soon as they change.",
      "seed": 691941308,
      "text": "3 Click a row to open it. Status and priority save\nas soon as they change.",
      "textAlign": "left",
      "type": "text",
      "version": 1,
      "versionNonce": 1395434647,
      "verticalAlign": "top",
      "width": 458,
      "x": 1506,
      "y": 582
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 20,
      "frameId": "muotyuwbnrb2zb",
      "height": 25,
      "id": "mv8r5pn9qa3j9l",
      "lineHeight": 1.25,
      "originalText": "+ New feedback opens a panel. Title is required.",
      "seed": 1420012742,
      "text": "+ New feedback opens a panel. Title is required.",
      "textAlign": "left",
      "type": "text",
      "version": 1,
      "versionNonce": 1768824125,
      "verticalAlign": "top",
      "width": 458,
      "x": 110,
      "y": 1374
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 20,
      "frameId": "muotyuwbnrb2zb",
      "height": 75,
      "id": "mv8r5pn9ijxptq",
      "lineHeight": 1.25,
      "originalText": "Add with no title shows the error and stays open. With a title it closes, and the item is at the top as New.",
      "seed": 1916410420,
      "text": "Add with no title shows the error and stays\nopen. With a title it closes, and the item is at the\ntop as New.",
      "textAlign": "left",
      "type": "text",
      "version": 1,
      "versionNonce": 714260089,
      "verticalAlign": "top",
      "width": 458,
      "x": 808,
      "y": 1374
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 20,
      "frameId": "muotyuwb19a556",
      "height": 50,
      "id": "mv8r5pn9hbb00d",
      "lineHeight": 1.25,
      "originalText": "No feedback at all: a message and a way to add some.",
      "seed": 1769233385,
      "text": "No feedback at all: a message and a way to add\nsome.",
      "textAlign": "left",
      "type": "text",
      "version": 1,
      "versionNonce": 603504095,
      "verticalAlign": "top",
      "width": 458,
      "x": 110,
      "y": 2166
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 20,
      "frameId": "muotyuwb19a556",
      "height": 50,
      "id": "mv8r5pn92fizk4",
      "lineHeight": 1.25,
      "originalText": "A search or filter that finds nothing says so. Clear or change it to see items again.",
      "seed": 691001762,
      "text": "A search or filter that finds nothing says so.\nClear or change it to see items again.",
      "textAlign": "left",
      "type": "text",
      "version": 1,
      "versionNonce": 1888323874,
      "verticalAlign": "top",
      "width": 458,
      "x": 808,
      "y": 2166
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 20,
      "frameId": "muotyuwc6v5rmt",
      "height": 50,
      "id": "mv8r5pn9iiur7a",
      "lineHeight": 1.25,
      "originalText": "Edit opens a dialog with the same form, filled in. Save updates the item in place.",
      "seed": 1936236276,
      "text": "Edit opens a dialog with the same form, filled in.\nSave updates the item in place.",
      "textAlign": "left",
      "type": "text",
      "version": 1,
      "versionNonce": 1273777216,
      "verticalAlign": "top",
      "width": 458,
      "x": 110,
      "y": 2958
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 20,
      "frameId": "muotyuwc6v5rmt",
      "height": 50,
      "id": "mv8r5pn9z1gj2l",
      "lineHeight": 1.25,
      "originalText": "The row menu can Mark resolved, which closes an item from the list. Off once resolved.",
      "seed": 828225707,
      "text": "The row menu can Mark resolved, which closes\nan item from the list. Off once resolved.",
      "textAlign": "left",
      "type": "text",
      "version": 1,
      "versionNonce": 450345007,
      "verticalAlign": "top",
      "width": 458,
      "x": 808,
      "y": 2958
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 20,
      "frameId": "muotyuwc68u4hy",
      "height": 50,
      "id": "mv8r5pn9ue17rg",
      "lineHeight": 1.25,
      "originalText": "Delete on the detail asks first. Confirming returns to the feedback inbox.",
      "seed": 299319217,
      "text": "Delete on the detail asks first. Confirming\nreturns to the feedback inbox.",
      "textAlign": "left",
